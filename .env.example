# Supabase project URL.
#
# Optional. When set, the contact form POSTs to the `send-contact-inquiry`
# edge function. When unset, the form falls back to opening WhatsApp with the
# message pre-filled — the site works fully without this.
#
# Find yours at https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
